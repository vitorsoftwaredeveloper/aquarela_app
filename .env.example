# API do backend (aquarela_serverless) — inclui a versão base (/v1)
NEXT_PUBLIC_API_URL=https://api.dev.aquarelakids.com/v1

# AWS Cognito (User Pool + App Client) — ver épico INF-02
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# (Opcional) Preview com dados de exemplo: login demo + fixtures locais, sem
# backend. Útil antes das rotas da API existirem. Deixe vazio/false em produção.
NEXT_PUBLIC_USE_MOCKS=false

# Firebase Cloud Messaging (Web Push) — épico I (NOT). Config do app Web do
# projeto Firebase (Configurações do projeto > Seus apps) + VAPID key
# (Configurações do projeto > Cloud Messaging > Web Push certificates).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
